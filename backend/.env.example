# Backend Environment Variables
# Copy this file to .env and adjust values for your local development or production environment.

# Server Port
PORT=4000

# MongoDB Connection String
# For local MongoDB: mongodb://localhost:27017/hiring-test
# For Docker Compose: mongodb://mongo:27017/hiring-test
MONGO_URI=mongodb://localhost:27017/hiring-test

# Secret Key used to sign and verify JSON Web Tokens (JWT)
JWT_SECRET=your_jwt_secret_key_change_in_production

# Frontend Client URL (for CORS and redirection)
FRONTEND_URL=http://localhost:5173
