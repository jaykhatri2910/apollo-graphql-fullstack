# Root-Level Environment Configuration
# Copy this file to .env if you wish to configure shared parameters from the repository root.

# Database Configuration (Used by root seed script and backend)
MONGO_URI=mongodb://localhost:27017/hiring-test

# Backend Server Configuration
PORT=4000
JWT_SECRET=your_jwt_secret_key_change_in_production
FRONTEND_URL=http://localhost:5173

# Frontend Vite Configuration
VITE_API_URL=http://localhost:4000/graphql

# Database Seed Customization
ADMIN_EMAIL=admin@example.com
DEFAULT_SEED_PASSWORD=password123
RESET_DB=false
